# Discord application (https://discord.com/developers/applications)
# Bot scopes: bot, applications.commands
# Privileged intent: Server Members Intent
# Interactions Endpoint URL: https://YOUR-APP.vercel.app/api/discord/interactions
# OAuth2 redirect: https://YOUR-APP.vercel.app/api/auth/callback
#
# Vercel: import this folder as its own project (Root Directory = ./)
# Discord OAuth redirect: https://YOUR-APP.vercel.app/api/auth/callback
# Interactions URL: https://YOUR-APP.vercel.app/api/discord/interactions

# FiveM server.cfg:
#   set sd_admin_discord_token "BOT_TOKEN"
#   set sd_admin_discord_guild "GUILD_ID"
#   set sd_admin_api_secret "SAME_AS_FIVEM_API_SECRET"
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=
DISCORD_GUILD_ID=

JWT_SECRET=change-me-to-a-long-random-string

# Example: http://1.2.3.4:30120/sd_admin
FIVEM_API_URL=
FIVEM_API_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
